generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  bio      String?
  projects Project[]
}

model Project {
  id            String       @id @default(uuid())
  title         String
  description   String
  url           String?
  upvotes       Int          @default(0)
  averageRating Float        @default(0)
  profileId     String
  profile       Profile      @relation(fields: [profileId], references: [id])
  feedbacks     Feedback[]
  technologies  Technology[]
}

model Feedback {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
}

model Technology {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
}