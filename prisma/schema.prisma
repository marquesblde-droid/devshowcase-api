generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Profile {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  bio      String?
  projects Project[]
}

model Project {
  id           String       @id @default(uuid())
  title        String
  description  String
  url          String?
  profileId    String
  profile      Profile      @relation(fields: [profileId], references: [id])
  feedbacks    Feedback[]
  technologies Technology[]
}

model Feedback {
  id        String   @id @default(uuid())
  comment   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
}

model Technology {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
}